# Application
APP_ENV=local
APP_BASE_URL=http://127.0.0.1:8080
PUBLIC_TRACE_BASE_URL=http://127.0.0.1:5173/t

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=agri_trace
DB_USERNAME=replace_me
DB_PASSWORD=replace_me

# FISCO BCOS 3.11
FISCO_GROUP_ID=group0
FISCO_PEERS=127.0.0.1:20200
FISCO_SDK_CERT_PATH=replace_with_local_untracked_path
FISCO_ACCOUNT_KEYSTORE_PATH=replace_with_local_untracked_path
FISCO_ACCOUNT_PASSWORD=replace_me
SYSTEM_HEX_PRIVATE_KEY=replace_me
FISCO_CONTRACT_ADDRESS=0x0102e8b6fc8cdf9626fddc1c3ea8c1e79b3fce94

# MQTT / EMQX
MQTT_ENABLED=false
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=replace_me
MQTT_PASSWORD=replace_me
MQTT_CLIENT_ID=agri-trace-backend-local
MQTT_TOPIC_TELEMETRY=agri/+/+/telemetry
MQTT_TOPIC_STATUS=agri/+/+/status
MQTT_TOPIC_EVENT=agri/+/+/event
MQTT_QOS=1
MQTT_KEEP_ALIVE_SECONDS=30
MQTT_CLEAN_SESSION=true

# IoT aggregation and alerts
IOT_WINDOW_MINUTES=5
IOT_OFFLINE_TIMEOUT_SECONDS=300
IOT_AUTO_REGISTER_GATEWAY=true
IOT_AUTO_REGISTER_DEVICE=true
IOT_ALERT_TEMPERATURE_MIN=-10
IOT_ALERT_TEMPERATURE_MAX=45
IOT_ALERT_HUMIDITY_MIN=20
IOT_ALERT_HUMIDITY_MAX=95
IOT_ALERT_SOIL_MOISTURE_MIN=15
IOT_ALERT_SOIL_MOISTURE_MAX=85
IOT_ALERT_LIGHT_MIN=0
IOT_ALERT_LIGHT_MAX=120000

# AI Provider
AI_PROVIDER=disabled
AI_BASE_URL=
AI_API_KEY=replace_me
AI_MODEL=

# Local storage
LOCAL_UPLOAD_DIR=.local/uploads
LOCAL_FISCO_CERT_DIR=.local/fisco/certs
